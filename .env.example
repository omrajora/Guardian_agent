# Guardian Agent 2.0 Environment Configuration

# Backend Server
PORT=5000
NODE_ENV=development
JWT_SECRET=super-secret-guardian-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/guardian_agent

# ML Inference Service (Python FastAPI)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=2000

# LLM Security Analysis (Gemini / OpenAI API)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_ENABLED=false
LLM_TIMEOUT_MS=3000

# Frontend Next.js Client
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
